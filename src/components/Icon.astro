---
// Small inline icons (currentColor). Decorative: the visible label next to them names the action.
interface Props { name: "whatsapp" | "phone" | "mail" | "pin" | "menu" | "down"; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
